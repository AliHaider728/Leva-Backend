{
  "name": "alvora-backend",
  "version": "1.0.0",
  "description": "Express + MySQL API Backend for Alvora Skincare",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate:routine-orders": "tsx src/scripts/migrateRoutineOrders.ts",
    "migrate:bundle-gallery": "tsx src/scripts/migrateBundleGallery.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "backfill:product-thumbnails": "tsx src/scripts/backfillProductThumbnails.ts",
    "migrate:product-merchandising": "tsx src/scripts/migrateProductMerchandising.ts",
    "start": "node app.js",
    "seed:reviews": "tsx src/scripts/seedReviews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.4",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.13",
    "sanitize-html": "2.17.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}

